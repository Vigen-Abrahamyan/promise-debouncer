    "async",
    "await",
    "debouncer",
    "promise-debounce",
    "async-debounce",
    "typescript"
  ],
  "author": "Vigen Abrahamyan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vigen-Abrahamyan/promise-debouncer.git"
  },
  "bugs": {
    "url": "https://github.com/Vigen-Abrahamyan/promise-debouncer/issues"
  },
  "homepage": "https://github.com/Vigen-Abrahamyan/promise-debouncer#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.5.3"
  }
}
